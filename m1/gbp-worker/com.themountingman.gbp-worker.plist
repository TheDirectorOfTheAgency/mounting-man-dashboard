<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.themountingman.gbp-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/thedirector/.local/share/themountingman/gbp-worker/venv/bin/python</string>
    <string>/Users/thedirector/.local/share/themountingman/gbp-worker/gbp_worker.py</string>
    <string>--once</string>
    <string>--headless</string>
  </array>
  <key>EnvironmentVariables</key>
