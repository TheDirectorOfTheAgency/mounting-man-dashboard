<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  M1 install-post publish worker. Installed by
  scripts/install-m1-install-post-worker.mjs, which fills the __PLACEHOLDERS__.
  The runner secret lives in INSTALL_POST_RUNNER_SECRET_FILE (0600), never here.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.themountingman.install-post-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__WORKER_SCRIPT__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>INSTALL_POST_API_BASE</key>
    <string>https://mounting-man-dashboard.vercel.app</string>
    <key>INSTALL_POST_M1_WORKER_ID</key>
    <string>m1-publish-01</string>
    <key>INSTALL_POST_RUNNER_SECRET_FILE</key>
    <string>__SECRET_FILE__</string>
    <key>INSTALL_POST_M1_PUBLISH_WRAPPER</key>
    <string>__WRAPPER__</string>
    <key>INSTALL_POST_M1_STATE_DIR</key>
    <string>__STATE_DIR__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__STATE_DIR__/worker.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE_DIR__/worker.error.log</string>
</dict>
</plist>
