# Copy this file to .env.local and fill in your credentials
# NEVER commit .env.local to git

# Square API
NEXT_PUBLIC_SQUARE_ACCESS_TOKEN=your_square_access_token_here
NEXT_PUBLIC_SQUARE_LOCATION_ID=LVNM3Z4RVRWDK
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key_here

# Webflow API
NEXT_PUBLIC_WEBFLOW_TOKEN=your_webflow_token_here
NEXT_PUBLIC_WEBFLOW_SITE_ID=6536f19431181574585ac1ce
NEXT_PUBLIC_WEBFLOW_INSTALLATIONS_COLLECTION_ID=68167d5a313e2fd6f18650c9

# Google Ads API (server-side only — no NEXT_PUBLIC_ prefix)
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_ADS_LOGIN_CUSTOMER_ID=3167428631

# Google Ads Offline Conversions
GOOGLE_ADS_OFFLINE_CONVERSION_ACTION_ID=7509313857
# observe | validate | one_shot | continuous (active is an alias for continuous)
OFFLINE_CONVERSION_MODE=observe

# Zenbooker Webhook
ZENBOOKER_WEBHOOK_SECRET=your_zenbooker_webhook_secret_here
ZENBOOKER_CONSENT_FIELD_LABEL=I consent to The Mounting Man securely sharing hashed contact information and service outcome data with advertising platforms for measurement
PRIVACY_DISCLOSURE_VERSION=your_disclosure_version_here

# Grok Bot Kronkite — paste both values from the Kronkite routine panel.
# Dashboard POSTs a sanitized Square job payload (no customer PII) after the
# 24h install-post dedup claim. Auth header: x-webhook-secret.
# If KRONKITE_SQUARE_WEBHOOK_URL is unset, the wake is skipped (SMS + queue still run).
KRONKITE_SQUARE_WEBHOOK_URL=
KRONKITE_SQUARE_WEBHOOK_KEY=

# Cloud installation-post queue (phone-first publish, no M1 dependency)
# Signs the per-job capability carried in the /install-posts/open#<capability>
# fragment, and the operator session cookie it is exchanged for. Owner-only.
INSTALL_POST_ACCESS_SECRET=generate_a_long_random_secret_here
# Signs server<->cloud-runner requests. MUST match the GitHub secret of the same name.
INSTALL_POST_RUNNER_SECRET=generate_a_different_long_random_secret_here
# Public origin used to build phone-first operator links.
INSTALL_POST_BASE_URL=https://mounting-man-dashboard.vercel.app
# GitHub workflow_dispatch credentials for the cloud runner.
INSTALL_POST_DISPATCH_TOKEN=github_token_with_actions_write_on_this_repo
INSTALL_POST_DISPATCH_OWNER=TheDirectorOfTheAgency
INSTALL_POST_DISPATCH_REPO=mounting-man-dashboard
INSTALL_POST_DISPATCH_WORKFLOW=publish-install-post.yml
INSTALL_POST_DISPATCH_REF=main

# Deployment health (manual/CLI fallback; VERCEL_GIT_COMMIT_SHA takes precedence)
DEPLOYMENT_COMMIT_SHA=your_git_commit_sha_here

# Vercel KV (auto-set by Vercel when you add a KV database in Dashboard → Storage)
# KV_REST_API_URL=auto_set_by_vercel
# KV_REST_API_TOKEN=auto_set_by_vercel

# Dashboard Config
NEXT_PUBLIC_DASHBOARD_REFRESH_INTERVAL=300000
